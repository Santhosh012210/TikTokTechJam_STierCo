# Operating system files
.DS_Store

# Editor and local agent settings
.vscode/
.claude/
CLAUDE.md

# Python cache and virtual environments
__pycache__/
*.pyc
venv/
.venv/

# Secrets — never commit
.env

# Generated and temporary files
temp/
# Per-run evidence stays local. The run promoted to the final submission is
# copied into artifacts/final/run/ by the finalizer, which is what ships.
# The README stays tracked so the evidence layout is documented in the repo.
artifacts/runs/*
!artifacts/runs/README.md

# Content-addressed sidecar for bulky trace payloads. Written per run under
# RUN_RESEARCH_DIR; this catches the fallback location used when no run
# directory is configured (offline tests).
artifacts/blobs/
src/test_run*
experiment_workspace/

# Local datasets
datasets/KuaiRand-Pure/
datasets/KuaiRand-1k/
datasets/KuaiRand-27k/
datasets/*.tar.gz
datasets/*.zip
