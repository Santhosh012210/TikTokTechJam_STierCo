# Copy to .env and fill in ONE provider section. Never commit .env to git.
#
# ── Anthropic (paid, cheapest with Haiku) ───────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001   # default

# ── Groq (free tier, Llama 3.3 70B) ─────────────────────────────────────────
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...                  # free at console.groq.com
# LLM_MODEL=llama-3.3-70b-versatile     # default

# ── Google Gemini (free tier, 1500 req/day) ──────────────────────────────────
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...                # free at aistudio.google.com
# LLM_MODEL=gemini-2.0-flash            # default

# ── Ollama (local, completely free) ──────────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2                    # or phi4, qwen2.5-coder, etc.
# OLLAMA_BASE_URL=http://localhost:11434/v1   # default
