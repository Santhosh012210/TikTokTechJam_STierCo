# Copy this file to .env.

# ── Active autonomous runner ─────────────────────────────────────────────────
# Recommended OpenAI configuration for the audited autonomous runner:
# AGENT_RUNTIME=langchain
# AGENT_MODEL=openai:gpt-5.6-terra
# AGENT_REASONING_EFFORT=low
# AGENT_MAX_RUN_COST_USD=1.00  # run_official.sh defaults to 25.00
# AGENT_AUTO_RESUME_QUOTA=1    # bounded unattended quota recovery
# OPENAI_API_KEY=<your-openai-api-key>
# LANGSMITH_TRACING=false

# Other audited configurations:
# AGENT_MODEL=anthropic:claude-sonnet-4-5-20250929
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# AGENT_MODEL=google_genai:gemini-2.5-pro
# GOOGLE_API_KEY=<your-google-api-key>
#
# The autonomous runner intentionally fails closed for unknown providers and
# model IDs. Arbitrary OpenAI-compatible endpoints are not accepted until their
# capabilities and token prices are registered in harness/provider.py.

# ── Legacy Builder/Strategist comparison runner ─────────────────────────────
# The legacy runner uses the generic variable names:
#   LLM_PROVIDER  required; selects the provider
#   LLM_API_KEY   required for hosted providers; omit for Ollama
#   LLM_MODEL     optional; omit to use the documented provider default
#   LLM_BASE_URL  optional; omit to use the provider's standard endpoint

# ── Anthropic ────────────────────────────────────────────────────────────────
# Default model: claude-haiku-4-5-20251001
# LLM_PROVIDER=anthropic
# LLM_API_KEY=<your-anthropic-api-key>
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Groq ─────────────────────────────────────────────────────────────────────
# Default model: openai/gpt-oss-120b
# LLM_PROVIDER=groq
# LLM_API_KEY=<your-groq-api-key>
# LLM_MODEL=openai/gpt-oss-120b

# ── Google Gemini (legacy comparison runner) ────────────────────────────────
# Default model: gemini-3.5-flash-lite
# LLM_PROVIDER=gemini
# LLM_API_KEY=<your-gemini-api-key>
# LLM_MODEL=gemini-3.5-flash-lite

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Legacy comparison runner default model: gpt-4o-mini
# LLM_PROVIDER=openai
# LLM_API_KEY=<your-openai-api-key>
# LLM_MODEL=gpt-4o-mini

# ── Ollama (local; no API key required) ──────────────────────────────────────
# Default model: llama3.2
# Default URL: http://localhost:11434/v1
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# Phase-aware memory: approximate-token thresholds at which the harness compacts
# bootstrap traffic into structured state, and how much recent experiment
# conversation survives that compaction.
# AGENT_CONTEXT_TOKEN_BUDGET=60000
# AGENT_EXPERIMENT_TAIL_TOKEN_BUDGET=24000

# Run discovery, the required reads, EDA, the environment inventory, and the
# baseline reproduction deterministically in Python before the first model call.
# Set to 0 to make the agent drive every bootstrap step itself.
# AGENT_BOOTSTRAP_PREFETCH=1
