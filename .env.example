# Copy this file to .env.

# ── Active autonomous runner: Google ADK + Gemini ───────────────────────────
# Default model: gemini-3.5-flash-lite
# Get a Gemini API key from https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-gemini-key-here
# ADK_MODEL=gemini-3.5-flash-lite

# Compatibility: the ADK runner also accepts the old Gemini setting below
# (LLM_PROVIDER=gemini + LLM_API_KEY + optional LLM_MODEL).

# ── Legacy Builder/Strategist comparison runner ─────────────────────────────
# The legacy runner uses the generic variable names:
#   LLM_PROVIDER  required; selects the provider
#   LLM_API_KEY   required for hosted providers; omit for Ollama
#   LLM_MODEL     optional; omit to use the documented provider default
#   LLM_BASE_URL  optional; omit to use the provider's standard endpoint

# ── Anthropic ────────────────────────────────────────────────────────────────
# Default model: claude-haiku-4-5-20251001
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Groq ─────────────────────────────────────────────────────────────────────
# Default model: openai/gpt-oss-120b
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_key_here
# LLM_MODEL=openai/gpt-oss-120b

# ── Google Gemini (also accepted by the ADK runner) ──────────────────────────
# Default model: gemini-3.5-flash-lite
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-key-here
# LLM_MODEL=gemini-3.5-flash-lite

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Default model: gpt-4o-mini
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key-here
# LLM_MODEL=gpt-4o-mini

# ── Ollama (local; no API key required) ──────────────────────────────────────
# Default model: llama3.2
# Default URL: http://localhost:11434/v1
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
